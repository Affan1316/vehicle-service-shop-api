# ==============================================================================
# Vehicle Service Shop API - Environment Configuration
# ==============================================================================
# Copy this file to .env and replace placeholder values for your environment.
# Example: cp .env.example .env

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="Vehicle Service Shop API"
APP_VERSION="1.0.0"
DEBUG=False
LOG_LEVEL="INFO"
ENVIRONMENT="development"  # Options: development, testing, staging, production

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + asyncpg)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/vehicle_service_shop"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 3. JWT AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="f68950e50905370e5306b266e011a9fffb5dcd93a3940151317e059c2f1fb5d2"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_AUTH=10

# Default Seed Administrator (used on initial seed_db.py execution)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_EMAIL="admin@autoserviceshop.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# ------------------------------------------------------------------------------
# 4. CORS & NETWORK ACCESS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ------------------------------------------------------------------------------
# 5. SHOP IDENTITY & BRANDING (Used in PDF Quotes & Invoices)
# ------------------------------------------------------------------------------
SHOP_NAME="Auto Service Shop"
SHOP_ADDRESS="123 Main Street, City, ST 12345"
SHOP_PHONE="(555) 555-0100"

# ------------------------------------------------------------------------------
# 6. TAX SETTINGS
# ------------------------------------------------------------------------------
TAX_RATE=0.07
TAX_LABEL="Sales Tax"

# ------------------------------------------------------------------------------
# 7. EMAIL NOTIFICATIONS (SMTP)
# ------------------------------------------------------------------------------
EMAIL_ENABLED=false
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@autoserviceshop.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="noreply@autoserviceshop.com"
SMTP_FROM_NAME="Auto Service Shop"
SMTP_USE_TLS=true

# ------------------------------------------------------------------------------
# 8. FILE ATTACHMENTS & UPLOADS
# ------------------------------------------------------------------------------
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_ENTITY=5
ALLOWED_EXTENSIONS="jpg,jpeg,png,gif,webp,pdf,doc,docx"

# ------------------------------------------------------------------------------
# 9. STRIPE PAYMENT GATEWAY
# ------------------------------------------------------------------------------
STRIPE_ENABLED=false
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_SUCCESS_URL="http://localhost:3000/payment/success?session_id={CHECKOUT_SESSION_ID}"
STRIPE_CANCEL_URL="http://localhost:3000/payment/cancel"
