# FastAPI Application settings
APP_NAME="Vehicle Service Shop API"
DEBUG=True

# Database Configuration
DATABASE_URL="postgresql+asyncpg://postgres:your-password-here@localhost:5432/vehicle_service_shop"

# JWT Security (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY="your-secret-key-here"

# CORS Configuration
CORS_ORIGINS="http://localhost:3000"

# Application Environment
ENVIRONMENT="development"
